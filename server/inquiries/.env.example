# Keep the GoDaddy web preview disabled until scoped authorization and persistence are verified.
INQUIRY_ENABLED=false
MAIL_SETUP_ENABLED=false
MAIL_AUTH_MODE=delegated
# HTTPS origin only, without the preview share token or any path.
MAIL_PUBLIC_ORIGIN=
# Private random password of at least 32 characters; gates setup and encrypts OAuth storage.
MAIL_SETUP_SECRET=
# Choose godaddy for platform sender, microsoft for the authenticated business mailbox.
MAIL_PROVIDER=godaddy
CONTACT_FORM_RECIPIENT_EMAIL=info@lajollacoralgables.com
# GoDaddy injects DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD automatically.
# Namespace is strictly preview or live. Leave preview until production is authorized.
INQUIRY_STORAGE_NAMESPACE=preview
# Configure on the private server, never in browser JavaScript or Git.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Generate a random private value of at least 32 characters.
INQUIRY_RATE_SECRET=
INQUIRY_ALLOWED_ORIGINS=https://jolla.peluzzza.com
INQUIRY_DATABASE=./private-data/inquiries.sqlite
INQUIRY_BIND=127.0.0.1
INQUIRY_TRUST_LOOPBACK_PROXY=false
PORT=8787
